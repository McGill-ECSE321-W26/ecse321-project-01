namespace ca.mcgill.ecse321.group1.model;

class Person {
  personID;
  email;
  password;
  1 -- 0..2 PersonRole roles;
}

class PersonRole {
  abstract;
  personRoleID;
}

class Manager {
  isA PersonRole;
}

class Employee {
  isA PersonRole;
  1 -- * Order preparingOrders;
}

class Customer {
  isA PersonRole;
  int loyaltyPoints;
  1 -- * Address addresses;
  1 <@>- 1 Cart;
  1 -- * Order orders;
}

class Address {
  addressID;
  street;
  city;
  province;
  postalCode;
}

class Cart {
  cartID;
  1 -- * CartItem items;
}

class Order {
  orderID;
  enum OrderStatus {
    Preparing,
    Delivered,
    Cancelled
  }
  OrderStatus orderStatus;
  Date orderDate;
  Date deliveryDate;
  0..1 -- * CartItem items;
}

class CartItem {
  clothingItemID;
  int quantity;
  * -- 1 ClothingVariant variants;
}

class ClothingVariant {
  clothingVariantID;
  enum Size {
    S,
    M,
    L,
    XL
  }
  Size size;
  color;
  int stockQuantity;
  * -- 1 ClothingModel model;
}

class ClothingModel {
  clothingModelID;
  name;
  float price;
}