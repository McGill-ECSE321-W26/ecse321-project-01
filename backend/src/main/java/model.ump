namespace ca.mcgill.ecse321.group1.model;

class Person {
  personID;
  email;
  password;
  1 -- 0..2 PersonRole roles;
}

class PersonRole {
  abstract;
  roleID;
}

class Manager {
  isA PersonRole;
}

class Employee {
  isA PersonRole;
  0..1 -- * Order preparingOrders;
}

class Customer {
  isA PersonRole;
  address;
  int loyaltyPoints;
  0..1 -- * Order orders;
  0..1 -- * Item;
}

class Order {
  orderID;
  enum OrderStatus {
    Preparing,
    Delivered,
    Cancelled
  }
  OrderStatus orderStatus;
  Date orderDate;
  Date deliveryDate;
  float loyaltySaving;
  address;
}

class Item {
  itemID;
  int quantity;
  float price;
  * -> 1 ClothingVariant;
  * -- 0..1 Order;
}

class ClothingVariant {
  clothingVariantID;
  enum Size {
    S,
    M,
    L,
    XL
  }
  Size size;
  color;
  imagePath;
  int stockQuantity;
  boolean archived = false;
  * -- 1 ClothingModel model;
}

class ClothingModel {
  clothingModelID;
  name;
  description;
  brand;
  enum Category {
    Tops,
    Bottoms,
    Dresses,
    Outerwear,
    Accessories
  }
  Category category;
  float price;
  boolean archived = false;
}